VITE_EMAILJS_SERVICE_ID=seu_service_id
VITE_EMAILJS_TEMPLATE_ID=seu_template_id
VITE_EMAILJS_PUBLIC_KEY=sua_public_key

# Formulário de contato (api/contact.ts, envio por SMTP com Nodemailer).
# Sem SMTP_HOST nada é enviado; fora de produção o conteúdo aparece no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Portfólio Luis Rodrigo <seu_email@gmail.com>"
# Para onde vão as mensagens. Vazio = a conta de SMTP_USER.
CONTACT_EMAIL=
